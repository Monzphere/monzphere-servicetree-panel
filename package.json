{
  "name": "monzphere-servicetree-panel",
  "version": "0.1.0",
  "description": "Hierarchical service tree with inline SLA/SLO indicators for Grafana dashboards.",
  "scripts": {
    "build": "TS_NODE_PROJECT=tsconfig.webpack.json webpack -c ./webpack.config.ts --env production",
    "dev": "TS_NODE_PROJECT=tsconfig.webpack.json webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --ext .js,.jsx,.ts,.tsx src tests",
    "lint:fix": "npm run lint -- --fix",
    "e2e": "playwright test",
    "package": "node ./scripts/package.js",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Monzphere",
  "license": "Apache-2.0",
  "devDependencies": {
    "@grafana/tsconfig": "^2.1.0",
    "@playwright/test": "^1.49.0",
    "@swc/core": "^1.10.0",
    "@swc/helpers": "^0.5.15",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.4.0",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^11.5.0",
    "@grafana/runtime": "^11.5.0",
    "@grafana/schema": "^11.5.0",
    "@grafana/ui": "^11.5.0",
    "lodash": "^4.17.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.10",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
