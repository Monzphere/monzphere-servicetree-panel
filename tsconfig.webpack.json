{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020",
    "esModuleInterop": true,
    "isolatedModules": false,
    "noEmit": false,
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["webpack.config.ts", "types/**/*"]
}
